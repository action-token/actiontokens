{
  "name": "@bandcoin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The tRPC API: context, procedures, the activity log, services (business logic) and one root router per app.",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/root-app.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@bandcoin/chain": "workspace:*",
    "@bandcoin/db": "workspace:*",
    "@bandcoin/errors": "workspace:*",
    "@bandcoin/wallet": "workspace:*",
    "@stellar/stellar-sdk": "catalog:",
    "@trpc/server": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bandcoin/eslint-config": "workspace:*",
    "@bandcoin/tsconfig": "workspace:*",
    "@bandcoin/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

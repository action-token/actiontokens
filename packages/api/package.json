{
  "name": "@bandcoin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The tRPC API: context, procedures, the activity log, services (business logic) and one root router per app.",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/root-app.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "testnet:demo": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-demo.ts",
    "testnet:buy": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-buy.ts"
  },
  "dependencies": {
    "@bandcoin/ar-core": "workspace:*",
    "@bandcoin/auth": "workspace:*",
    "@bandcoin/chain": "workspace:*",
    "@bandcoin/db": "workspace:*",
    "@bandcoin/errors": "workspace:*",
    "@bandcoin/geo": "workspace:*",
    "@bandcoin/page": "workspace:*",
    "@bandcoin/storage": "workspace:*",
    "@bandcoin/utils": "workspace:*",
    "@bandcoin/wallet": "workspace:*",
    "@huggingface/transformers": "catalog:",
    "@photostructure/tz-lookup": "catalog:",
    "@stellar/stellar-sdk": "catalog:",
    "@trpc/server": "catalog:",
    "google-auth-library": "catalog:",
    "openai": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bandcoin/eslint-config": "workspace:*",
    "@bandcoin/tsconfig": "workspace:*",
    "@bandcoin/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

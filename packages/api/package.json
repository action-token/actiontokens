{
  "name": "@actiontokens/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The tRPC API: context, procedures, the activity log, services (business logic) and one root router per app.",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/root-app.ts",
    "./agent-contract": "./src/services/agent/contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "testnet:demo": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-demo.ts",
    "testnet:buy": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-buy.ts",
    "testnet:trust": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-trust.ts",
    "testnet:resale": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-resale.ts",
    "testnet:nft-resale": "tsx --env-file=../db/.env --env-file=../../apps/app/.env.local scripts/testnet-nft-resale.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@actiontokens/ar-core": "workspace:*",
    "@actiontokens/auth": "workspace:*",
    "@actiontokens/chain": "workspace:*",
    "@actiontokens/db": "workspace:*",
    "@actiontokens/errors": "workspace:*",
    "@actiontokens/geo": "workspace:*",
    "@actiontokens/page": "workspace:*",
    "@actiontokens/storage": "workspace:*",
    "@actiontokens/utils": "workspace:*",
    "@actiontokens/wallet": "workspace:*",
    "@huggingface/transformers": "catalog:",
    "@photostructure/tz-lookup": "catalog:",
    "@stellar/stellar-sdk": "catalog:",
    "@trpc/server": "catalog:",
    "google-auth-library": "catalog:",
    "nodemailer": "catalog:",
    "@google/genai": "catalog:",
    "openai": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@actiontokens/eslint-config": "workspace:*",
    "@actiontokens/tsconfig": "workspace:*",
    "@actiontokens/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

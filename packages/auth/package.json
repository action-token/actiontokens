{
  "name": "@actiontokens/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sign-in for every web app: turns a credential (wallet signature, Firebase token, email + password) into a user, logs the attempt, and the NextAuth options built on it.",
  "exports": {
    ".": "./src/index.ts",
    "./email-account": "./src/email-account.ts",
    "./email-lookup": "./src/email-lookup.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@albedo-link/signature-verification": "catalog:",
    "@actiontokens/db": "workspace:*",
    "@actiontokens/errors": "workspace:*",
    "@actiontokens/utils": "workspace:*",
    "@actiontokens/wallet": "workspace:*",
    "axios": "catalog:",
    "firebase": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-auth": "catalog:"
  },
  "devDependencies": {
    "@actiontokens/eslint-config": "workspace:*",
    "@actiontokens/tsconfig": "workspace:*",
    "@actiontokens/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

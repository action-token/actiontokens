{
  "name": "@actiontokens/ar-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The AR app's pure domain code, shared by its screens and its API: pin and card types, distance maths, rarity, mural constants and scoring. No React, no server imports.",
  "exports": {
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "date-fns": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@actiontokens/eslint-config": "workspace:*",
    "@actiontokens/tsconfig": "workspace:*",
    "@actiontokens/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

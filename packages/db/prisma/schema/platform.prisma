// Platform-wide: settings, uploads, activity log, worker job queue and the
// id map used by the one-time legacy migration.

/// Single row (id = 1) of settings admins can change.
model AppSetting {
  id                       Int      @id @default(1)
  nearbyPinRadiusMeters    Float    @default(500)
  /// Fan tokens issued into a new artist's storage account when an admin approves them
  fanTokenStartSupply      Decimal  @default(1000000) @db.Decimal(20, 7)
  platformFeeBps           Int      @default(250)
  platformFeeRecipient     String?
  vanityMonthlyBandcoin    Decimal? @db.Decimal(20, 7)
  vanityMonthlyUsd         Decimal? @db.Decimal(20, 7)
  vanityNameChangeBandcoin Decimal? @db.Decimal(20, 7)
  vanityNameChangeUsd      Decimal? @db.Decimal(20, 7)
  /// Admin › Alerts thresholds; missing keys use the defaults in services/admin/alerts.ts
  alertRules               Json?
  updatedAt                DateTime @updatedAt

  @@map("app_settings")
}

/// An admin marked one alert as looked at, so it leaves the Alerts list. The
/// key names the exact occurrence (kind, who, latest event), so a new
/// occurrence shows again.
model AdminAlertReview {
  key        String   @id
  kind       String
  reviewerId String?
  reviewer   User?    @relation("AlertReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime @default(now())

  @@map("admin_alert_reviews")
}

/// Every object we put in S3, so unused uploads can be cleaned up.
model Upload {
  key       String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  sizeBytes BigInt
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("uploads")
}

enum ActorRole {
  GUEST
  FAN
  ARTIST
  ADMIN
  SYSTEM
}

enum ActivityStatus {
  SUCCESS
  FAILED
}

/// One row per mutation and sign-in, written by tRPC middleware. Append-only:
/// nothing updates or deletes rows except the retention job (1 year, money
/// rows kept forever).
model ActivityLog {
  id         BigInt         @id @default(autoincrement())
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  ActorRole
  /// Procedure name, e.g. "order.create", "pin.claim", "admin.artist.ban"
  action     String
  targetType String?
  targetId   String?
  /// Request input with secrets, signed XDR, tokens and emails masked
  input      Json?
  status     ActivityStatus
  errorCode  String?
  txHash     String?
  amount     Decimal?       @db.Decimal(20, 7)
  currency   Currency?
  /// "app" | "org" | "ar" | "worker"
  app        String
  ip         String?
  userAgent  String?
  requestId  String?
  durationMs Int?
  createdAt  DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@map("activity_logs")
}

/// The worker's queue. Picked with FOR UPDATE SKIP LOCKED; retried with backoff.
model Job {
  id          String    @id @default(cuid())
  /// e.g. "media.transcode", "generation.run", "hotspot.drop"
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, createdAt])
  @@map("jobs")
}

/// Old bandfan id → new id, so the legacy migration can re-run and later
/// steps can find foreign keys. Drop after cutover.
model LegacyIdMap {
  legacyTable String
  legacyId    String
  newId       String
  createdAt   DateTime @default(now())

  @@id([legacyTable, legacyId])
  @@index([newId])
  @@map("legacy_id_map")
}

/// An access token for an AI app (Claude, Cursor…) to use the map agent as this person.
/// Shown once when made; only its SHA-256 is kept.
model McpToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the person called it, e.g. "Claude Desktop"
  name       String
  tokenHash  String    @unique
  /// The token's first characters, to tell tokens apart in the list
  prefix     String
  /// The session's wallet type when the token was made
  walletType String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("mcp_tokens")
}

// Artists, their memberships, page, domains and connected services.

enum ArtistStatus {
  /// Applied, waiting for an admin
  PENDING
  APPROVED
  BANNED
  /// An admin turned the application down; the artist's XLM was returned and they can apply again
  REJECTED
}

model Artist {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  slug              String        @unique
  bio               String?
  avatarUrl         String?
  coverUrl          String?
  /// { default, desktop, mobile } cover heights in px
  coverHeights      Json?
  /// { default, desktop, mobile } section order
  sectionLayouts    Json?
  backgroundSvg     String?
  showBackgroundSvg Boolean       @default(false)
  website           String?
  twitter           String?
  instagram         String?
  status            ArtistStatus  @default(PENDING)
  /// What the admin told the applicant when rejecting
  rejectionReason   String?
  storageAccountId  String?       @unique
  storageAccount    ChainAccount? @relation("ArtistStorage", fields: [storageAccountId], references: [id], onDelete: SetNull)
  /// The artist's one issuer: their fan token and every item they create are
  /// issued by it (Wadzzo model). The artist pays to open it once; copies are
  /// minted when fans buy or claim.
  issuerAccountId   String?       @unique
  issuerAccount     ChainAccount? @relation("ArtistIssuer", fields: [issuerAccountId], references: [id], onDelete: SetNull)
  /// The artist's fan token: an Item of type FAN_TOKEN. Tiers are "hold N of it".
  fanTokenItemId    String?       @unique
  fanTokenItem      Item?         @relation("ArtistFanToken", fields: [fanTokenItemId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items              Item[]
  albums             Album[]
  tiers              MembershipTier[]
  followers          Follow[]
  vanityUrl          VanityUrl?
  vanityPayments     VanityPayment[]
  customDomain       CustomDomain?
  pageLayouts        PageLayout[]
  facebook           FacebookConnection?
  posts              Post[]
  pins               Pin[]
  hotspots           Hotspot[]
  pinTags            PinTag[]
  pinBatchJobs       PinBatchJob[]
  aiUsage            AiUsage[]
  bounties           Bounty[]
  royaltyPayouts     RoyaltyPayout[]
  generations        Generation[]
  agentJobs          AgentJob[]
  agentConversations AgentConversation[]
  events             Event[]
  announcements      Announcement[]
  mapEmbeds          MapEmbed[]

  @@index([status, createdAt])
  @@map("artists")
}

/// A membership level: hold `requiredTokens` of the artist's fan token.
model MembershipTier {
  id             String   @id @default(cuid())
  artistId       String
  artist         Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name           String
  description    String
  features       String[]
  color          String?
  isPopular      Boolean  @default(false)
  isActive       Boolean  @default(true)
  requiredTokens Decimal  @db.Decimal(20, 7)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  items Item[]
  posts Post[]
  pins  Pin[]

  @@unique([artistId, name])
  @@map("membership_tiers")
}

model Follow {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  /// Followed without a trustline yet (was TemporalFollow)
  isTemporary Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@id([userId, artistId])
  @@index([artistId])
  @@map("follows")
}

enum VanityStatus {
  TRIAL
  ACTIVE
  GRACE
  LAPSED
}

enum VanityPaymentKind {
  FREE_TRIAL
  RENEWAL
  NAME_CHANGE
}

/// bandcoin.io/name. First month free, then a monthly renewal; on lapse a
/// 7-day grace, then the name is reserved for 30 days.
model VanityUrl {
  artistId      String       @id
  artist        Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name          String       @unique
  status        VanityStatus @default(TRIAL)
  startedAt     DateTime     @default(now())
  paidUntil     DateTime
  graceEndsAt   DateTime?
  reservedUntil DateTime?
  updatedAt     DateTime     @updatedAt

  @@map("vanity_urls")
}

model VanityPayment {
  id        String            @id @default(cuid())
  artistId  String
  artist    Artist            @relation(fields: [artistId], references: [id], onDelete: Cascade)
  kind      VanityPaymentKind
  currency  Currency
  amount    Decimal           @db.Decimal(20, 7)
  orderId   String?           @unique
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  periodEnd DateTime
  createdAt DateTime          @default(now())

  @@index([artistId, createdAt])
  @@map("vanity_payments")
}

model CustomDomain {
  id         String    @id @default(cuid())
  artistId   String    @unique
  artist     Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  domain     String    @unique
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("custom_domains")
}

enum LayoutStatus {
  DRAFT
  PUBLISHED
}

/// An artist page design (page builder). One is active at a time.
model PageLayout {
  id              String       @id @default(cuid())
  artistId        String?
  artist          Artist?      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name            String
  templateKey     String?
  isDefault       Boolean      @default(false)
  isPublic        Boolean      @default(false)
  isActive        Boolean      @default(false)
  status          LayoutStatus @default(DRAFT)
  theme           Json?
  /// Block[] being edited
  draftBlocks     Json?
  /// Block[] visitors see
  publishedBlocks Json?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  widgets PageWidget[]

  @@index([artistId, isActive])
  @@map("page_layouts")
}

model PageWidget {
  id          String     @id @default(cuid())
  layoutId    String
  layout      PageLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  /// e.g. "stats", "profile"
  widgetType  String
  /// "small" | "medium" | "large"
  size        String
  sortOrder   Int
  pinned      Boolean    @default(false)
  groupId     String?
  customWidth Float?
  settings    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([layoutId])
  @@map("page_widgets")
}

/// Starting points in the page builder ("musician", "visual-artist"…).
model PageTemplate {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String
  previewImageUrl String?
  /// Exactly one template is the default for new artists
  isSeedDefault   Boolean  @default(false)
  sortOrder       Int      @default(0)
  blocks          Json
  theme           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("page_templates")
}

model FacebookConnection {
  artistId           String   @id
  artist             Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  pageId             String
  pageName           String
  /// AES-256-GCM, "iv:tag:ciphertext" hex
  pageTokenEncrypted String
  autoPublish        Boolean  @default(false)
  connectedAt        DateTime @default(now())

  @@map("facebook_connections")
}

model LastFmAccount {
  userId      String  @id
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  realName    String?
  country     String?
  sessionKey  String? @unique
  profileUrl  String
  imageUrl    String?
  playCount   Int     @default(0)
  isConnected Boolean @default(false)

  @@map("lastfm_accounts")
}

/// How many AI generations an artist has used on a UTC day (the free daily allowance).
model AiUsage {
  artistId String
  artist   Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  text     Int      @default(0)
  image    Int      @default(0)

  @@id([artistId, day])
  @@map("ai_usage")
}

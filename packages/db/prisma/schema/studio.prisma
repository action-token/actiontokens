// Studio: AI generation paid with studio coins (a real Stellar token).
// Artists deposit coins once on-chain; each generation spends from the
// deposited balance; failed jobs are refunded; unused balance can be withdrawn.

/// Deposited studio coins. Always equals the sum of CONFIRMED ledger entries;
/// written in the same database transaction as each entry.
model StudioBalance {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(20, 7)
  updatedAt DateTime @updatedAt

  @@map("studio_balances")
}

enum StudioLedgerKind {
  /// On-chain payment into the studio treasury
  DEPOSIT
  /// A generation's cost (PENDING while it runs)
  SPEND
  /// A failed generation's cost returned
  REFUND
  /// Paid back on-chain
  WITHDRAW
  BONUS
  /// Carried over from the old database credits
  MIGRATED
}

enum LedgerStatus {
  PENDING
  CONFIRMED
  FAILED
}

model StudioLedgerEntry {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         StudioLedgerKind
  status       LedgerStatus     @default(PENDING)
  /// Positive adds to the balance, negative spends
  amount       Decimal          @db.Decimal(20, 7)
  txHash       String?          @unique
  generationId String?
  generation   Generation?      @relation(fields: [generationId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("studio_ledger_entries")
}

/// Coin bundles sold in Studio. Like listings, priced in BANDCOIN and USD;
/// XLM and USDC are computed live.
model StudioPackage {
  id            String   @id @default(cuid())
  name          String
  description   String?
  coins         Decimal  @db.Decimal(20, 7)
  bonusCoins    Decimal  @default(0) @db.Decimal(20, 7)
  priceBandcoin Decimal  @db.Decimal(20, 7)
  priceUsd      Decimal  @db.Decimal(20, 7)
  isPopular     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("studio_packages")
}

enum GenerationType {
  TEXT
  IMAGE
  MUSIC
  VIDEO
  SEO
  SOCIAL
}

/// One AI generation run (was GenerationJob + AiGeneratedContent).
model Generation {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId   String?
  artist     Artist?        @relation(fields: [artistId], references: [id], onDelete: SetNull)
  type       GenerationType
  prompt     String
  model      String?
  status     JobStatus      @default(QUEUED)
  progress   Int?
  message    String?
  cost       Decimal        @default(0) @db.Decimal(20, 7)
  tokensUsed Int?
  /// [{ type, url }]
  outputs    Json?
  error      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  ledgerEntries StudioLedgerEntry[]

  @@index([userId, createdAt])
  @@map("generations")
}

/// A run of the pin/hotspot AI agent.
model AgentJob {
  id        String    @id @default(cuid())
  artistId  String
  artist    Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  status    JobStatus @default(QUEUED)
  payload   Json
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([artistId, createdAt])
  @@map("agent_jobs")
}

/// A saved session of the stem editor.
model StemProject {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@map("stem_projects")
}

/// A chat with the pin/hotspot AI agent.
model AgentConversation {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMessage[]
  actions  AgentAction[]

  @@index([artistId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role           String
  text           String
  /// Rich blocks shown in the chat (pin cards, maps…)
  blocks         Json?
  /// Tool steps the agent took
  steps          Json?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

/// Something the agent proposed (create pins, a hotspot…) that the artist confirms.
model AgentAction {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  artistId       String
  type           String
  payload        Json
  /// "proposed" | "confirmed" | "rejected" | "done" | "failed"
  status         String
  result         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([conversationId])
  @@map("agent_actions")
}

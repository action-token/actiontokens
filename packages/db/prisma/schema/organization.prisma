// Organizations, their memberships, page, domains and connected services.

enum OrganizationStatus {
  /// Applied, waiting for an admin
  PENDING
  APPROVED
  BANNED
  /// An admin turned the application down; the artist's XLM was returned and they can apply again
  REJECTED
}

model Organization {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  slug              String             @unique
  bio               String?
  avatarUrl         String?
  coverUrl          String?
  /// { default, desktop, mobile } cover heights in px
  coverHeights      Json?
  /// { default, desktop, mobile } section order
  sectionLayouts    Json?
  backgroundSvg     String?
  showBackgroundSvg Boolean            @default(false)
  website           String?
  twitter           String?
  instagram         String?
  status            OrganizationStatus @default(PENDING)
  /// What the admin told the applicant when rejecting
  rejectionReason   String?
  storageAccountId  String?            @unique
  storageAccount    ChainAccount?      @relation("OrganizationStorage", fields: [storageAccountId], references: [id], onDelete: SetNull)
  /// The artist's one issuer: their fan token and every item they create are
  /// issued by it (Wadzzo model). The artist pays to open it once; copies are
  /// minted when fans buy or claim.
  issuerAccountId   String?            @unique
  issuerAccount     ChainAccount?      @relation("OrganizationIssuer", fields: [issuerAccountId], references: [id], onDelete: SetNull)
  /// The artist's fan token: an Item of type FAN_TOKEN. Tiers are "hold N of it".
  fanTokenItemId    String?            @unique
  fanTokenItem      Item?              @relation("OrganizationFanToken", fields: [fanTokenItemId], references: [id], onDelete: SetNull)
  /// The fan token chosen while applying ({ mode: NEW | EXISTING, code, issuer?, coverUrl });
  /// created when an admin approves, then cleared
  pendingFanToken   Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items              Item[]
  albums             Album[]
  tiers              MembershipTier[]
  followers          Follow[]
  vanityUrl          VanityUrl?
  vanityPayments     VanityPayment[]
  customDomain       CustomDomain?
  pageLayouts        PageLayout[]
  facebook           FacebookConnection?
  posts              Post[]
  stories            Story[]
  pins               Pin[]
  hotspots           Hotspot[]
  pinTags            PinTag[]
  pinLayers          PinLayer[]
  pinShapes          PinShape[]
  pinTemplates       PinTemplate[]
  pinBatchJobs       PinBatchJob[]
  bounties           Bounty[]
  royaltyPayouts     RoyaltyPayout[]
  agentJobs          AgentJob[]
  agentConversations AgentConversation[]
  events             Event[]
  announcements      Announcement[]
  mapEmbeds          MapEmbed[]
  previousSlugs      OrganizationSlugHistory[]

  @@index([status, createdAt])
  @@map("organizations")
}

/// An address an artist's page used before a rename, so old /artist/{slug}
/// links keep working (they redirect to the current one). A slug here can't
/// be taken by another artist.
model OrganizationSlugHistory {
  slug           String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("organization_slug_history")
}

/// A membership level: hold `requiredTokens` of the artist's fan token.
model MembershipTier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String
  features       String[]
  color          String?
  isPopular      Boolean      @default(false)
  isActive       Boolean      @default(true)
  requiredTokens Decimal      @db.Decimal(20, 7)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  items        Item[]
  posts        Post[]  @relation("PostTier")
  commentPosts Post[]  @relation("PostCommentTier")
  collectPosts Post[]  @relation("PostCollectTier")
  stories      Story[] @relation("StoryTier")
  pins         Pin[]

  @@unique([organizationId, name])
  @@map("membership_tiers")
}

model Follow {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// true: just a follower (no trustline to the artist's fan token); false: a subscriber (has the trustline).
  /// Was TemporalFollow. Kept true to the chain by the follow service and the `follows.sync` job.
  isTemporary    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("follows")
}

enum VanityStatus {
  TRIAL
  ACTIVE
  GRACE
  LAPSED
}

enum VanityPaymentKind {
  FREE_TRIAL
  RENEWAL
  NAME_CHANGE
}

/// action-tokens.com/name. First month free, then a monthly renewal; on lapse a
/// 7-day grace, then the name is reserved for 30 days.
model VanityUrl {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @unique
  status         VanityStatus @default(TRIAL)
  startedAt      DateTime     @default(now())
  paidUntil      DateTime
  graceEndsAt    DateTime?
  reservedUntil  DateTime?
  updatedAt      DateTime     @updatedAt

  @@map("vanity_urls")
}

model VanityPayment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           VanityPaymentKind
  currency       Currency
  amount         Decimal           @db.Decimal(20, 7)
  orderId        String?           @unique
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  periodEnd      DateTime
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@map("vanity_payments")
}

/// Where a custom domain stands (plan 32). Only LIVE domains are served.
enum CustomDomainStatus {
  /// Copied from bandfan: not on the host yet, the artist reconnects it
  NEEDS_SETUP
  /// On the host, waiting for DNS and SSL
  PENDING
  LIVE
  /// Was live, the host now says it fails (DNS removed, SSL failed)
  BROKEN
}

/// An artist's own domain showing their artist page (plan 32). One per artist.
model CustomDomain {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Lower case, no scheme, no www (a root domain's www is `withWww`)
  domain         String             @unique
  status         CustomDomainStatus @default(PENDING)
  /// Root domains: www.<domain> is on the host too, redirecting to the root
  withWww        Boolean            @default(false)
  /// First time it went live
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  brokenSince    DateTime?
  /// The host's last complaint, in its words
  lastError      String?
  createdAt      DateTime           @default(now())

  @@index([status, lastCheckedAt])
  @@map("custom_domains")
}

enum LayoutStatus {
  DRAFT
  PUBLISHED
}

/// An artist page design (page builder). One is active at a time.
model PageLayout {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  templateKey     String?
  isDefault       Boolean       @default(false)
  isPublic        Boolean       @default(false)
  isActive        Boolean       @default(false)
  status          LayoutStatus  @default(DRAFT)
  theme           Json?
  /// Block[] being edited
  draftBlocks     Json?
  /// Block[] visitors see
  publishedBlocks Json?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  widgets PageWidget[]

  @@index([organizationId, isActive])
  @@map("page_layouts")
}

model PageWidget {
  id          String     @id @default(cuid())
  layoutId    String
  layout      PageLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  /// e.g. "stats", "profile"
  widgetType  String
  /// "small" | "medium" | "large"
  size        String
  sortOrder   Int
  pinned      Boolean    @default(false)
  groupId     String?
  customWidth Float?
  settings    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([layoutId])
  @@map("page_widgets")
}

/// Starting points in the page builder ("musician", "visual-artist"…).
model PageTemplate {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String
  previewImageUrl String?
  /// Exactly one template is the default for new artists
  isSeedDefault   Boolean  @default(false)
  sortOrder       Int      @default(0)
  blocks          Json
  theme           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("page_templates")
}

model FacebookConnection {
  organizationId     String       @id
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pageId             String
  pageName           String
  /// AES-256-GCM, "iv:tag:ciphertext" hex
  pageTokenEncrypted String
  autoPublish        Boolean      @default(false)
  connectedAt        DateTime     @default(now())

  @@map("facebook_connections")
}

model LastFmAccount {
  userId      String  @id
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  realName    String?
  country     String?
  sessionKey  String? @unique
  profileUrl  String
  imageUrl    String?
  playCount   Int     @default(0)
  isConnected Boolean @default(false)

  @@map("lastfm_accounts")
}

/// How many AI generations an artist has used on a UTC day (the free daily allowance).
model AiUsage {
  /// Per person, so applicants (no artist yet) and artists share one allowance
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  text   Int      @default(0)
  image  Int      @default(0)

  @@id([userId, day])
  @@map("ai_usage")
}

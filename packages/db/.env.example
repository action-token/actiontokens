# ActionTokens database settings. Copy to packages/db/.env (never commit real values).

# The NEW database. For local development use the Docker one (pnpm db:up):
DATABASE_URL="postgresql://actiontokens:actiontokens@127.0.0.1:55432/actiontokens_dev"

# The OLD Actionverse database, opened READ ONLY by the legacy migration (never written).
LEGACY_DATABASE_URL=""

# Safety rails for scripts that write in bulk (seed, legacy copy). A local database is always
# allowed; any other host must be listed here by the owner. Protected hosts are always refused.
# ALLOW_DESTRUCTIVE_HOSTS=
# PROTECTED_HOSTS=your-production-db-host,your-legacy-db-host

# Only for the final cutover copy (see docs/FORK-PLAN.md): the target host must be listed in
# CUTOVER_ALLOWED_HOSTS and typed back in CUTOVER_CONFIRM, and CHAIN_ACCOUNT_KEY must be set.
# CUTOVER_ALLOWED_HOSTS=
# CUTOVER_CONFIRM=
# CHAIN_ACCOUNT_KEY=

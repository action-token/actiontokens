{
  "name": "@actiontokens/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Action Tokens worker: finishes payments whose answer got lost, processes music, runs agent jobs, makes batch pins, drops hotspot pins, and relays live music.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backfill:music": "tsx --env-file-if-exists=.env.local src/backfill-music.ts"
  },
  "dependencies": {
    "@actiontokens/api": "workspace:*",
    "@actiontokens/db": "workspace:*",
    "@actiontokens/errors": "workspace:*",
    "tsx": "catalog:",
    "@actiontokens/storage": "workspace:*"
  },
  "devDependencies": {
    "@actiontokens/eslint-config": "workspace:*",
    "@actiontokens/tsconfig": "workspace:*",
    "@actiontokens/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

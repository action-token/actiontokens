# Action Tokens worker. Copy to .env.local for `pnpm --filter @actiontokens/worker dev`,
# or set these on the host. Names only here: never commit values.
# Commented lines are optional: leave them commented, since an empty value
# would replace the default.
#
# The worker signs ONE kind of transaction: the platform treasury's records of
# NFT unlocks (jobs nft.unlocks and nft.keep-alive), so it needs TREASURY_SECRET.
# It never signs for a fan or an artist.

# Database (the same one the apps use)
DATABASE_URL=
# Connections the worker may open
# DATABASE_POOL_MAX=

# Firebase web config. The worker never signs anyone in, but the shared wallet package reads
# these as soon as it loads, so it won't start without them. Same values as the web apps.
NEXT_PUBLIC_AUTH_FIREBASE_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_PROJECT_ID=
NEXT_PUBLIC_AUTH_STORAGE_BUCKET=
NEXT_PUBLIC_AUTH_MESSAGING_SENDER_ID=
NEXT_PUBLIC_AUTH_APP_ID=
# NEXT_PUBLIC_STAGE=

# Stellar: which network, and where to ask about transactions
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# HORIZON_URL=
# SOROBAN_RPC_URL=
# STELLAR_BASE_FEE=
NEXT_PUBLIC_ASSET_CODE=
NEXT_PUBLIC_ASSET_ISSUER=
# NEXT_PUBLIC_USDC_ISSUER=
PLATFORM_TREASURY=
# Signs the unlock records (public key above must be its account)
TREASURY_SECRET=
# Contract NFTs: reading the edition id a registration got, and the unlock records
# NFT_CONTRACT=

# Square: refunding a card when its payment failed on Stellar
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox

# S3: reading uploads, storing processed music, AI images/videos and place photos
# (NEXT_AWS_* also works)
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# The map agent and batch pins: OpenAI (the agent and pin tags), Google Maps
# (places, geocoding, photos). Without them those jobs fail with a clear message.
OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=
GOOGLE_MAP_API_KEY=

NEXTAUTH_SECRET=

# How many jobs run at once. Music processing (ffmpeg) has its own loops; everything else shares
# the general ones. The defaults suit a 2-CPU, 2 GB server shared with another worker.
# WORKER_CONCURRENCY=3
# WORKER_TRANSCODE_SLOTS=1
# A job running longer than this many milliseconds is failed (default 900000 = 15 minutes)
# JOB_TIMEOUT_MS=

# Health check port, and ffmpeg if it isn't on PATH
PORT=8080
# FFMPEG_PATH=
# FFPROBE_PATH=

# Email (gift emails). Leave empty to send none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Links in emails
# NEXT_PUBLIC_APP_URL=

# Facebook page sync: the worker opens page tokens to copy new posts in. Same key as the portal.
SOCIAL_TOKEN_ENC_KEY=
# FACEBOOK_GRAPH_VERSION=

# --- Custom domains (plan 32) ----------------------------------------------------
# Which host artists' domains are attached to: "vercel", or leave empty for none
# (Settings then says custom domains aren't open yet).
DOMAIN_HOST=
# A Vercel token that can manage the FAN APP's project, the project id (or name),
# and the team id when the project belongs to a team.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Holder rewards (jobs rewards.sync and rewards.distribute). The payout account is the mother
# account, so MOTHER_SECRET must be set here for rounds to be paid. On mainnet the three below
# default to the ACTION / PLOT assets; on testnet set them to try a round.
# MOTHER_SECRET=
# REWARD_ACTION_ASSET=ACTION-G...
# REWARD_PLOT_ASSET=PLOT-G...
# REWARD_PLOT_DISTRIBUTOR=G...
# Telegram (job telegram.bounty) needs no env: the bot and channel are set in Admin › Telegram.

# Artist portal. Copy to .env.local. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STAGE=dev
NEXT_PUBLIC_STELLAR_PUBNET=false
NEXT_PUBLIC_ASSET_CODE=
NEXT_PUBLIC_ASSET_ISSUER=

# Sign-in. Every app uses the same NEXTAUTH_SECRET so one login works everywhere.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
# Production only: ".bandcoin.io" shares the login across bandcoin.io and all subdomains.
AUTH_COOKIE_DOMAIN=
MOTHER_SECRET=
RUBY_ACCOUNTS_SECRET=
NEXT_PUBLIC_AUTH_FIREBASE_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_PROJECT_ID=
NEXT_PUBLIC_AUTH_STORAGE_BUCKET=
NEXT_PUBLIC_AUTH_MESSAGING_SENDER_ID=
NEXT_PUBLIC_AUTH_APP_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Payments
PLATFORM_TREASURY=
# Dev only: USD per BANDCOIN on testnet, where the asset has no market. Ignored on mainnet.
BANDCOIN_USD_PRICE=
CHAIN_ACCOUNT_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION=

# Dev: where the fan app runs (the "Open Bandcoin" link)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Treasury (the nft_oz contract's price authority); same account as PLATFORM_TREASURY
TREASURY_SECRET=
NFT_CONTRACT=
ESCROW_CONTRACT=

# Maps (Mapbox public token, pk.*): use Wadzzo's, the account that owns the Wadzzo 3D styles; the same one the AR app uses
NEXT_PUBLIC_MAPBOX_API=

# AI help on the create pages (Fill with AI, Write with AI, generated images). Leave empty to switch it off.
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_TEXT_MODEL=
# OPENAI_IMAGE_MODEL=

# Dev: where the AR app runs (website-map preview and snippets)
NEXT_PUBLIC_AR_URL=http://localhost:3002

# ── Database ──────────────────────────────────────────────────────────────
# Optional: most connections one server instance opens (leave empty for the default)
DATABASE_POOL_MAX=

# ── File storage (S3) ─────────────────────────────────────────────────────
# Uploads: covers, music, art, mural photos.
NEXT_AWS_BUCKET_NAME=
NEXT_AWS_BUCKET_REGION=
NEXT_AWS_ACCESS_KEY=
NEXT_AWS_SECRET_ACCESS_KEY=

# ── Site details ──────────────────────────────────────────────────────────
# Shown to wallet apps when someone connects.
NEXT_PUBLIC_TITLE=
NEXT_PUBLIC_DESC=
NEXT_PUBLIC_ICON=
NEXT_PUBLIC_URL=

# ── Last.fm ───────────────────────────────────────────────────────────────
# Track search and connect on bounties. Uses bandfan's artist-side Last.fm app.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Email (gift emails). Leave empty to send none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Facebook page sync (Settings › Facebook). The app's id and secret come from a
# Facebook developer app; the redirect is https://<portal>/api/facebook/callback and the
# webhook is https://<portal>/api/webhooks/facebook (subscribe the app to Page "feed").
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
# Any long random string you also type into the app's webhook settings
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Seals page tokens in the database: 64 hex characters (openssl rand -hex 32)
SOCIAL_TOKEN_ENC_KEY=
# NEXT_PUBLIC_FACEBOOK_CONFIG_ID=
# FACEBOOK_GRAPH_VERSION=

# Fan app. Copy to .env.local. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STAGE=dev
NEXT_PUBLIC_STELLAR_PUBNET=false
NEXT_PUBLIC_ASSET_CODE=
NEXT_PUBLIC_ASSET_ISSUER=

# Sign-in. Every app uses the same NEXTAUTH_SECRET so one login works everywhere.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002
# Production only: ".bandcoin.io" shares the login across bandcoin.io and all subdomains.
AUTH_COOKIE_DOMAIN=
MOTHER_SECRET=
RUBY_ACCOUNTS_SECRET=
NEXT_PUBLIC_AUTH_FIREBASE_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_PROJECT_ID=
NEXT_PUBLIC_AUTH_STORAGE_BUCKET=
NEXT_PUBLIC_AUTH_MESSAGING_SENDER_ID=
NEXT_PUBLIC_AUTH_APP_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Payments
PLATFORM_TREASURY=
CHAIN_ACCOUNT_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION=

# Map tiles and search (Mapbox public token, pk.*): use Wadzzo's, the account that owns the Wadzzo 3D styles
NEXT_PUBLIC_MAPBOX_API=
# Fan app, for links out of AR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# This app's own URL (calendar links, shared links)
NEXT_PUBLIC_AR_URL=
# S3: mural scan photos (the fan app's bucket)
NEXT_AWS_BUCKET_NAME=
NEXT_AWS_BUCKET_REGION=
NEXT_AWS_ACCESS_KEY=
NEXT_AWS_SECRET_ACCESS_KEY=
# Last.fm: listening progress on music bounties
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
# Google Cloud Vision service-account JSON (one line): mural scan checks.
# Unset: checks are skipped in development and scanning is refused in production.
GOOGLE_VISION_CREDENTIALS=
# Origins allowed to frame /embed/preview (default: the artist portal)
ORG_APP_ORIGINS=

# Treasury (the nft_oz contract's price authority); same account as PLATFORM_TREASURY
TREASURY_SECRET=
NFT_CONTRACT=
ESCROW_CONTRACT=

# ── Database ──────────────────────────────────────────────────────────────
# Optional: most connections one server instance opens (leave empty for the default)
DATABASE_POOL_MAX=

# ── Site details ──────────────────────────────────────────────────────────
# Shown to wallet apps when someone connects.
NEXT_PUBLIC_TITLE=
NEXT_PUBLIC_DESC=
NEXT_PUBLIC_ICON=
NEXT_PUBLIC_URL=

# ── Mural scan checks (Google Cloud Vision) ───────────────────────────────
# Without credentials, scanning is refused in production. The service-account key
# goes in GOOGLE_VISION_CREDENTIALS (above) as one line.
# Google Cloud project that Vision usage is billed to
GOOGLE_CLOUD_PROJECT=
